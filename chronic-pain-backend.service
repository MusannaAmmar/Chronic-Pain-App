[Unit]
Description=Chronic Pain Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/chronic-pain-backend
EnvironmentFile=/home/ubuntu/chronic-pain-backend/.env
ExecStart=/home/ubuntu/chronic-pain-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
